# ==============================================================================
# Anusandhan - Environment Variables Template
# Copy this file to .env and configure with your credentials
# DO NOT commit real secrets to GitHub
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=production
JWT_SECRET=your_long_random_jwt_secret_key_minimum_32_characters

# AI Microservice URL (FastAPI)
FASTAPI_BACKEND_URL=http://localhost:8000
PYTHON_SERVICE_URL=http://localhost:8000/api/v1

# SQLite Database Persistence Path
DATABASE_URL=sqlite:///./server/db/anusandhan.sqlite

# Optional: MongoDB URI (if using MongoDB instead of default SQLite)
# MONGODB_URI=mongodb://127.0.0.1:27017/anusandhan_db

# Optional: Redis Cache (if using distributed Redis instead of in-memory LRU)
# REDIS_URL=redis://127.0.0.1:6379

# Google Gemini API Key (Required for AI paper deconstruction and voice mentor)
GEMINI_API_KEY=your_gemini_api_key_here

# Payment Gateway Keys (Optional for monetization testing)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Social Authentication OAuth 2.0 (Google, GitHub, LinkedIn)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
VITE_GITHUB_CLIENT_ID=your_github_client_id
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
VITE_LINKEDIN_CLIENT_ID=your_linkedin_client_id
GOOGLE_REDIRECT_URI=http://localhost:5000/api/outreach/oauth/callback
