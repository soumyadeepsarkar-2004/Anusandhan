# =========================================================================
# Cloudflare Pages Production Headers for ResearchIntern Pro (अनुसंधान AI)
# Global Edge Caching & Security Hardening (Zero-Budget Tier)
# =========================================================================

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Permissions-Policy: microphone=(self), camera=(), geolocation=()
  Access-Control-Allow-Origin: *

# Immutable Edge & Browser Caching for Fingerprinted Assets
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# HTML Pages: No-Cache for Fast Deploys
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Static Icons & Emblems
/*.svg
  Cache-Control: public, max-age=86400
/*.png
  Cache-Control: public, max-age=86400
