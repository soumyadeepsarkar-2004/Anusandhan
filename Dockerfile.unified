# ==============================================================================
# Anusandhan - Unified Full-Stack Production Container
# Builds React SPA & packages into Node.js Express Gateway
# Ideal for single-port deployments on Render, Railway, Fly.io, Heroku, AWS ECS
# ==============================================================================

# Stage 1: Build React SPA
FROM node:20-alpine AS frontend-builder
WORKDIR /build

COPY package*.json tsconfig*.json vite.config.ts tailwind.config.js postcss.config.js index.html ./
RUN npm ci

COPY public ./public
COPY src ./src
RUN npm run build

# Stage 2: Production Server Runtime
FROM node:20-alpine AS production
WORKDIR /app

ENV NODE_ENV=production \
    PORT=5000 \
    DATABASE_URL=sqlite:///app/server/db/anusandhan.sqlite

# Install curl for health checking
RUN apk add --no-cache curl

# Install Gateway Dependencies
COPY server/package*.json ./server/
RUN cd server && npm ci --only=production

# Copy Server Code and Frontend Production Build
COPY server ./server
COPY --from=frontend-builder /build/dist ./dist

# Create persistent database folder with proper permissions
RUN mkdir -p /app/server/db && chown -R node:node /app

USER node

EXPOSE 5000

HEALTHCHECK --interval=15s --timeout=5s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:5000/api/health || exit 1

CMD ["node", "server/server.js"]
